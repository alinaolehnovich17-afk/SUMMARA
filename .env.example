# Скопируйте этот файл в .env и впишите свой ключ Anthropic.
# Получить ключ: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# (опционально) Настройки Whisper
# WHISPER_MODEL_SIZE=base        # tiny | base | small | medium | large-v2 | large-v3
# WHISPER_DEVICE=cpu             # cpu | cuda
# WHISPER_COMPUTE_TYPE=int8      # int8 | float16 | float32
# WHISPER_LANGUAGE=ru            # код языка или пусто = автоопределение
