# Секреты — НИКОГДА не коммитить
.env
user_settings.json

# Виртуальное окружение
.venv/
venv/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/

# Модели Whisper (большие, качаются автоматически)
models/*
!models/.gitkeep

# Результаты генерации
exports/*
!exports/.gitkeep

# Локальный конфиг Claude Code (пути/права конкретной машины)
.claude/settings.local.json

# Референсные картинки дизайнов (нужны только при разработке, не в рантайме;
# возможны сторонние/Canva-скриншоты — не публикуем по умолчанию)
primer/
stl/

# ОС / редакторы
.DS_Store
Thumbs.db
.idea/
.vscode/
